---
import type { Author } from "../types/types";

interface Props {
  authors: Author[];
}

const { authors } = Astro.props;
---

<div class="links mx-auto w-fit max-w-[min(95vw,72rem)] flex flex-row flex-nowrap items-baseline justify-center gap-x-3 sm:gap-x-5 px-2">
  {
    authors.map((author) => (
      <div class="flex flex-col items-center whitespace-nowrap text-center">
        <div class="flex flex-row whitespace-nowrap text-sm sm:text-lg">
          {author.url ? <a href={author.url}>{author.name}</a> : author.name}
          {author.notes && (
            <sup class="text-xl">
              {author.notes.map(
                (note, index, array) =>
                  note + (index < array.length - 1 ? "," : ""),
              )}
            </sup>
          )}
        </div>
        {author.institution && <div>{author.institution}</div>}
      </div>
    ))
  }
</div>
